# Provider is picked by which key is set: ANTHROPIC_API_KEY > OPENROUTER_API_KEY > ZAI_API_KEY.

# Real Anthropic API.
# ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-sonnet-4-5-20250929

# OpenRouter (Anthropic-compatible endpoint, any model).
# OPENROUTER_API_KEY=
# OPENROUTER_BASE_URL=https://openrouter.ai/api
# OPENROUTER_MODEL=anthropic/claude-haiku-4.5

# z.ai (free GLM models).
ZAI_API_KEY=
ZAI_BASE_URL=https://api.z.ai/api/anthropic
ZAI_MODEL=glm-4.5-flash

# Set to true for vision-capable models (e.g. Claude via Anthropic/OpenRouter).
# AGENT_VISION=true
